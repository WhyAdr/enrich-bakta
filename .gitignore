# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class

# Dataset inventory is tracked separately from code. The full local inventory
# remains ignored; only the explicitly curated CC-BY-4.0 corpus is materialized
# in Git LFS after its manifest has been reviewed.
/data/C14/
/data/SM/
/data/BK71A/
/data/fixtures/

!/data/C14/
/data/C14/**
!/data/C14/bakta/
!/data/C14/bakta/*.gbff
!/data/C14/bakta/*.faa
!/data/C14/baktfold/
!/data/C14/baktfold/*.gbff
!/data/C14/baktfold/*.faa
!/data/C14/evidence/
!/data/C14/evidence/*-KofamKOALA.txt
!/data/C14/evidence/*-emapper_annotations.xlsx
!/data/C14/evidence/*-query.emapper.annotations
!/data/C14/evidence/*-query.emapper.hits
!/data/C14/evidence/*-query.emapper.seed_orthologs
!/data/C14/evidence/*-query.emapper.seed_orthologs.sorted
!/data/C14/derived/
!/data/C14/derived/restored/
!/data/C14/derived/restored/*.gbff
!/data/C14/derived/restored/*.manifest.json
!/data/C14/derived/enriched/
!/data/C14/derived/enriched/*.gbff
!/data/C14/derived/enriched/*.manifest.json

!/data/SM/
/data/SM/**
!/data/SM/bakta/
!/data/SM/bakta/*.gbff
!/data/SM/bakta/*.faa
!/data/SM/baktfold/
!/data/SM/baktfold/*.gbff
!/data/SM/baktfold/*.faa
!/data/SM/evidence/
!/data/SM/evidence/*-KofamKOALA.txt
!/data/SM/evidence/*-emapper_annotations.xlsx
!/data/SM/evidence/*-query.emapper.annotations
!/data/SM/evidence/*-query.emapper.hits
!/data/SM/evidence/*-query.emapper.seed_orthologs
!/data/SM/evidence/*-query.emapper.seed_orthologs.sorted
!/data/SM/derived/
!/data/SM/derived/restored/
!/data/SM/derived/restored/*.gbff
!/data/SM/derived/restored/*.manifest.json
!/data/SM/derived/enriched/
!/data/SM/derived/enriched/*.gbff
!/data/SM/derived/enriched/*.manifest.json

!/data/BK71A/
/data/BK71A/**
!/data/BK71A/derived/
!/data/BK71A/derived/restored/
!/data/BK71A/derived/restored/*.gbff

# Retained local build/test caches
/.cache/
/.test-output/
.pytest_cache/

.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/
