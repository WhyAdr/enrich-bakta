{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/enrich-bakta/dataset-manifest.v1.schema.json",
  "title": "enrich-bakta dataset manifest",
  "type": "object",
  "required": ["schema", "artifacts"],
  "properties": {
    "schema": {
      "const": "enrich-bakta.dataset-manifest.v1"
    },
    "publication": {
      "type": "object",
      "required": ["license", "storage", "status_policy", "owner_authorization"],
      "properties": {
        "license": {"type": "string", "minLength": 1},
        "storage": {"enum": ["git-lfs"]},
        "status_policy": {"type": "string", "minLength": 1},
        "owner_authorization": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "id",
        "path",
        "sample",
        "role",
        "size_bytes",
        "sha256",
        "lineage",
        "producer",
        "status",
        "redistribution",
        "validation"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[^\\\\]+$"
        },
        "sample": {"type": "string", "minLength": 1},
        "role": {
          "enum": [
            "upstream_input",
            "functional_evidence",
            "annotation_source",
            "derived_output",
            "fixture"
          ]
        },
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "lineage": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "producer": {
          "type": "object",
          "required": ["name", "version", "database"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "database": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        },
        "status": {
          "enum": ["historical_unverified", "validated", "published", "local_only"]
        },
        "redistribution": {
          "type": "object",
          "required": ["license", "permission"],
          "properties": {
            "license": {"type": ["string", "null"]},
            "permission": {"type": ["string", "null"]}
          },
          "additionalProperties": true
        },
        "validation": {
          "type": "object",
          "required": ["code_commit", "checks"],
          "properties": {
            "code_commit": {"type": ["string", "null"]},
            "checks": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  }
}
